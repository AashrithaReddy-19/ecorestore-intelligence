# Copy this file to .env and fill in values as needed.
# Every value below has a safe local-dev default in app/config.py, so the
# project runs with NO secrets configured (SQLite + deterministic fallback).

# --- Backend --------------------------------------------------------------

# PostgreSQL connection string. If unset, SQLite is used automatically
# (backend/ecorestore.db).
# Example: postgresql://user:password@localhost:5432/ecorestore
DATABASE_URL=

# "openai" to enable LLM-polished narrative text, or "none" (default) to use
# the deterministic template fallback (no key required).
LLM_PROVIDER=none

# Required only when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Where ChromaDB persists its vector index.
CHROMA_PERSIST_DIRECTORY=./knowledge_base/chroma_store

ENVIRONMENT=development

# --- Frontend ---------------------------------------------------------------

# Base URL of the deployed/running backend API.
VITE_API_BASE_URL=http://localhost:8000
